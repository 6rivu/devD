[Unit]
Description=CVOLVE-PRO Streamlit App
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cvolvepro/CVOLVE-PRO
EnvironmentFile=/etc/cvolvepro.env
ExecStart=/opt/cvolvepro/CVOLVE-PRO/.venv/bin/streamlit run app.py \
    --server.port=8502 \
    --server.address=0.0.0.0 \
    --server.baseUrlPath=app \
    --browser.gatherUsageStats=false
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
