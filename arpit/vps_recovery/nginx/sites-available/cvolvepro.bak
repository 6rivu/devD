server {
    listen 80;
    listen [::]:80;
    server_name cvolvepro.com www.cvolvepro.com;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.cvolvepro.com;

    ssl_certificate     /etc/letsencrypt/live/cvolvepro.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cvolvepro.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://cvolvepro.com$request_uri;
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cvolvepro.com;

    ssl_certificate     /etc/letsencrypt/live/cvolvepro.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cvolvepro.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Static landing page
    root  /var/www/cvolvepro/public;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }
location /app/ {
        proxy_pass http://127.0.0.1:8501/;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_read_timeout 600s;
    }
location = /app {
        return 301 /app/;
    }
}
