# =========================================================
# ORBYNECUE – INTERNAL APP (PORT 8081)
# =========================================================
server {
    listen 8081;
    listen [::]:8081;

    server_name orbynecue.com www.orbynecue.com;

    root /var/www/orbynecue;
    index index.html;

    access_log /var/log/nginx/orbynecue.access.log;
    error_log  /var/log/nginx/orbynecue.error.log;

    # ---------- FRONTEND ----------
    location / {
        try_files $uri $uri/ =404;
    }

    # ---------- BACKEND API ----------
    location /orbyneai/api/ {
        proxy_pass http://127.0.0.1:8001/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---------- STRIPE WEBHOOK ----------
    location = /orbyneai/api/webhook {
        proxy_pass http://127.0.0.1:8001/orbyneai/api/webhook;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# =========================================================
# ORBYNECUE – HTTPS PUBLIC ENTRY (443 → 8081)
# =========================================================
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;

    server_name orbynecue.com www.orbynecue.com;

    ssl_certificate /etc/letsencrypt/live/orbynecue.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/orbynecue.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    access_log /var/log/nginx/orbynecue.access.log;
    error_log  /var/log/nginx/orbynecue.error.log;

    # ---------- FRONTEND ----------
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ---------- DOWNLOADS ----------
    location /downloads/ {
        proxy_pass http://127.0.0.1:8001/downloads/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ---------- BACKEND API ----------
    location /orbyneai/api/ {
        proxy_pass http://127.0.0.1:8001/;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # ---------- STRIPE WEBHOOK ----------
    location = /orbyneai/api/webhook {
        proxy_pass http://127.0.0.1:8001/orbyneai/api/webhook;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}

# =========================================================
# ORBYNECUE – HTTP → HTTPS REDIRECT
# =========================================================
server {
    listen 80;
    listen [::]:80;

    server_name orbynecue.com www.orbynecue.com;
    return 301 https://orbynecue.com$request_uri;
}
