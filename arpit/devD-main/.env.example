# =============================================================================
# CVOLVE PRO — Environment variables (copy to .env and fill in values)
# cp .env.example .env
# =============================================================================

# --- PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cvolvepro
DB_USER=postgres
DB_PASSWORD=your_password_here

# --- AI ---
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_JOBSQA_WEBHOOK_SECRET=whsec_...

# --- Email (Resend) ---
RESEND_API_KEY=re_...
APP_FROM_EMAIL=onboarding@yourdomain.com
FROM_EMAIL=JobsQA <no-reply@yourdomain.com>

# --- API auth (FastAPI / JobsQA JWT) ---
JWT_SECRET=change_this_to_a_long_random_secret
FLASK_SECRET=change_this_to_a_long_random_secret

# --- API server ---
PORT=8000
CV_CREDIT_COST=3
CV_MAX_PAGES=2
DEFAULT_TEMPLATE=professional

# --- Optional: SMTP (smtp_test.py only; app uses Resend) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
